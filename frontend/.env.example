# Florecer Frontend Environment Variables
# Copy to .env.local for development

# BFF API base URL
VITE_BFF_URL=http://localhost:8787

# R2 CDN base URL for assets
VITE_R2_URL=https://r2-cdn-dev.florecer.com

# Environment override (dev | production)
VITE_ENV=dev

# Sentry DSN for error tracking (optional in dev)
# VITE_SENTRY_DSN=https://...
